// Quartus system lib
#include <system.h>

// Standard lib
#include <stdio.h>

// Project lib
#include "Software_NiosII/include/hex.h"


/**
 * @brief Converts a digit (0-9) and a segment index (0-3) to its 7-segment display representation.
 *
 * This function maps the given digit to its corresponding 7-segment display pattern
 * and shifts it according to the specified segment index. This function is to be used with
 * the following example :
 *
 * HEX54bits = (seg7(1, 1) | seg7(2, 0));
 * HEX30bits = (seg7(3, 3) | seg7(4, 2) | seg7(5, 1) | seg7(6, 0));
 *
 * IOWR_ALTERA_AVALON_PIO_DATA(HEX5_HEX4_BASE, HEX54bits);
 * IOWR_ALTERA_AVALON_PIO_DATA(HEX3_HEX0_BASE, HEX30bits);
 *
 * with HEX5_HEX4_BASE and HEX3_HEX0_BASE being described in <system.h> and the altera function
 * described in <altera_avalon_pio_regs.h>
 *
 * @param value Decimal digit to display (0-9)
 * @param seg   Chooses which segment to light (0-3)
 * @return int  Encoded value for the 7-segment display
 */

int seg7(int value, int seg){
    int decal[] = {0,8,16,24};

    switch (value) {
        case 0: return (0x40 << decal[seg]);
        case 1: return (0x79 << decal[seg]);
        case 2: return (0x24 << decal[seg]);
        case 3: return (0x30 << decal[seg]);
        case 4: return (0x19 << decal[seg]);
        case 5: return (0x12 << decal[seg]);
        case 6: return (0x02 << decal[seg]);
        case 7: return (0x78 << decal[seg]);
        case 8: return (0x00 << decal[seg]);
        case 9: return (0x10 << decal[seg]);
        default: return (0xFF << decal[seg]);
    }
}



